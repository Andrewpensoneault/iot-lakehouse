FROM docker.io/library/python:3.12-slim-trixie

ARG SPARK_VERSION=4.2.0
ARG DELTA_VERSION=4.4.0
ARG DELTA_ARTIFACT=delta-spark_4.2_2.13
ARG HADOOP_AWS_VERSION=3.5.0
ARG AWS_SDK_VERSION=2.35.4
ARG ANALYTICS_ACCEL_VERSION=1.3.1

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jre-headless procps curl \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      pyspark==${SPARK_VERSION} \
      delta-spark==${DELTA_VERSION}

RUN JARS=$(python -c "import pyspark, os; print(os.path.join(os.path.dirname(pyspark.__file__), 'jars'))") \
 && MVN=https://repo1.maven.org/maven2 \
 && curl -fsSL -o "$JARS/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
      "$MVN/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
 && curl -fsSL -o "$JARS/bundle-${AWS_SDK_VERSION}.jar" \
      "$MVN/software/amazon/awssdk/bundle/${AWS_SDK_VERSION}/bundle-${AWS_SDK_VERSION}.jar" \
 && curl -fsSL -o "$JARS/analyticsaccelerator-s3-${ANALYTICS_ACCEL_VERSION}.jar" \
      "$MVN/software/amazon/s3/analyticsaccelerator/analyticsaccelerator-s3/${ANALYTICS_ACCEL_VERSION}/analyticsaccelerator-s3-${ANALYTICS_ACCEL_VERSION}.jar" \
 && curl -fsSL -o "$JARS/${DELTA_ARTIFACT}-${DELTA_VERSION}.jar" \
      "$MVN/io/delta/${DELTA_ARTIFACT}/${DELTA_VERSION}/${DELTA_ARTIFACT}-${DELTA_VERSION}.jar" \
 && curl -fsSL -o "$JARS/delta-storage-${DELTA_VERSION}.jar" \
      "$MVN/io/delta/delta-storage/${DELTA_VERSION}/delta-storage-${DELTA_VERSION}.jar"

RUN useradd --create-home --uid 1000 spark
USER spark
WORKDIR /app